# Server Configuration
PORT=9000
NODE_ENV=development

# File Upload Settings
# Maximum file size in bytes (50MB = 52428800)
MAX_FILE_SIZE=52428800

# File Size Limits by Type (in bytes)
MAX_PDF_SIZE=104857600      # 100MB
MAX_IMAGE_SIZE=20971520      # 20MB
MAX_DOCUMENT_SIZE=52428800   # 50MB
MAX_EXCEL_SIZE=10485760      # 10MB
MAX_TOTAL_UPLOAD_SIZE=209715200  # 200MB

# CORS Settings
# Comma-separated list of allowed origins
# Examples: http://localhost:5173,http://localhost:5174,https://example.com
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Comma-separated list of headers to expose to clients
CORS_EXPOSED_HEADERS=Content-Disposition,X-Original-Size,X-Compressed-Size

# Google Generative AI (for image generation features)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# LibreOffice Path (optional - for document conversions)
# Leave empty to use system default
# LIBREOFFICE_PATH=/usr/bin/libreoffice

# Python Path (optional - for PDF processing)
# Leave empty to use system default
# PYTHON_PATH=/usr/bin/python3

# Security Settings
ENABLE_MALWARE_SCAN=true
ENABLE_FILE_SIGNATURE_CHECK=true

# Logging
LOG_LEVEL=info
